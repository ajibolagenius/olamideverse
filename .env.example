NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required for npm run seed:cms — use a strong unique password (12+ chars).
# Never reuse the old example default "olamideverse-admin".
# Must NOT use @fan.olamideverse.app (reserved for Fan Zone accounts).
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=

# Canonical site URL for metadata, robots.txt, and sitemap.xml (set this in production)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public takedown contact (Legal page). Also storable in CMS general.takedownEmail
# (admin-only / service-role read — not exposed to anon PostgREST).
# TAKEDOWN_EMAIL=takedown@yourdomain.com

# Analytics (GA4 G-… or GTM-… only). CMS general.analyticsId overrides when set.
# NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Spotify Web API (Client Credentials) — used by npm run fill:spotify-catalog
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Required in production: gates /api/cron/keep-alive. Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET` automatically once this is set as a
# project env var — without it, the endpoint rejects every request.
# CRON_SECRET=
